# -----------------------------------------------------------------------------
# Docker Compose infrastructure
# Copy this file to .env, replace every "replace-with-..." value, and keep it
# out of version control. Put OpenAI keys in .env.local and AI Prime Tech keys
# in .env.aiprimetech.local; both are ignored and loaded after .env.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nexora-ai-platform
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# Backend runtime
# "auto" uses AI Prime Tech/OpenAI when its separate key is configured and
# safely falls back to the deterministic local provider otherwise. Use "mock"
# for fully repeatable, offline evaluations.
# -----------------------------------------------------------------------------
NEXORA_ENVIRONMENT=development
NEXORA_LOG_LEVEL=INFO
NEXORA_CORS_ORIGINS=["http://localhost:3000"]
NEXORA_AI_PROVIDER_MODE=auto
NEXORA_OPENAI_BASE_URL=https://api.openai.com/v1
NEXORA_OPENAI_CHAT_MODEL=gpt-4.1-mini
NEXORA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXORA_AIPRIMETECH_BASE_URL=https://aiprimetech.io/v1
NEXORA_AIPRIMETECH_FABLE_MODEL=claude-fable-5
NEXORA_AIPRIMETECH_SONNET_MODEL=claude-sonnet-5
NEXORA_AIPRIMETECH_OPUS_MODEL=claude-opus-5
# AI Prime may need longer to return the first token. Its routed model fallback
# chain replaces same-model transport retries, keeping failure latency bounded.
NEXORA_AIPRIMETECH_REQUEST_TIMEOUT_SECONDS=90
NEXORA_AIPRIMETECH_MAX_PROVIDER_RETRIES=0
# JSON prices are USD per 1M input/output tokens. Fable is from the public
# catalog; verify private Sonnet/Opus IDs and override their estimates here.
NEXORA_AIPRIMETECH_PRICING_USD_PER_MILLION={"claude-fable-5":{"input":3,"output":15,"source":"AI Prime Tech public catalog"},"claude-sonnet-5":{"input":3,"output":15,"source":"configurable estimate; verify private catalog"},"claude-opus-5":{"input":3,"output":15,"source":"configurable estimate; verify private catalog"}}
NEXORA_REQUEST_TIMEOUT_SECONDS=30
NEXORA_EMBEDDING_BATCH_SIZE=64
NEXORA_CONFIDENCE_THRESHOLD=0.65
NEXORA_MAX_UPLOAD_BYTES=104857600
NEXORA_MAX_DOCUMENT_CHARS=20000000
NEXORA_MAX_DOCUMENT_CHUNKS=25000
NEXORA_MAX_MESSAGE_CHARS=12000
NEXORA_REVIEW_CLAIM_TIMEOUT_SECONDS=300
NEXORA_RATE_LIMIT_REQUESTS=60
NEXORA_RATE_LIMIT_WINDOW_SECONDS=60
NEXORA_TRUST_PROXY_HEADERS=true
NEXORA_EVAL_CASES_PATH=/app/data/eval_cases/cases.json

# Provider secrets: leave blank in this tracked template.
OPENAI_API_KEY=
# Keep AI Prime Tech credentials in ignored .env.aiprimetech.local, not here:
# AIPRIMETECH_API_KEY=

# Optional Redis profile. Redis is isolated on the internal Docker network and
# is not started unless `--profile cache` is supplied.
NEXORA_REDIS_URL=redis://redis:6379/0
