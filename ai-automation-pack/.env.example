# -----------------------------------------------------------------------------
# Local Docker Compose defaults
# Copy to .env before first start. Put real provider keys in ignored .env.local.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ai-automation-pack
POSTGRES_DB=automation_pack
POSTGRES_USER=automation_pack
POSTGRES_PASSWORD=replace-with-a-long-url-safe-local-password
POSTGRES_PORT=5434
BACKEND_PORT=8004
FRONTEND_PORT=3004
N8N_PORT=5678

# Shared internal credential. Replace it in .env for any non-ephemeral setup.
# This value is used only across the private Compose network.
AUTOMATION_INTERNAL_TOKEN=replace-with-a-random-internal-token
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# -----------------------------------------------------------------------------
# FastAPI runtime
# -----------------------------------------------------------------------------
AUTOMATION_ENVIRONMENT=development
AUTOMATION_DEBUG=false
AUTOMATION_CORS_ORIGINS=http://localhost:3004,http://localhost:5173
AUTOMATION_AI_PROVIDER=mock
AUTOMATION_AI_FALLBACK_PROVIDER=mock
AUTOMATION_AI_MAX_ATTEMPTS=2
AUTOMATION_AI_TIMEOUT_SECONDS=12
AUTOMATION_AUTO_ACTION_CONFIDENCE_THRESHOLD=0.85
AUTOMATION_OPENAI_MODEL=gpt-4.1-mini
# USD per 1M input/output tokens. Model snapshots inherit the longest matching base-model rate.
# Update this local JSON tariff table when provider pricing changes.
AUTOMATION_OPENAI_PRICING_USD_PER_MILLION={"gpt-4.1-mini":{"input":"0.40","output":"1.60"},"default":{"input":"0.40","output":"1.60"}}
AUTOMATION_MEDIUM_RISK_REQUIRES_REVIEW=true
AUTOMATION_INCIDENT_DEDUP_WINDOW_MINUTES=15
AUTOMATION_INVOICE_TOLERANCE=0.01
AUTOMATION_USE_N8N=true
AUTOMATION_N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
AUTOMATION_N8N_DISPATCH_TIMEOUT_SECONDS=150
AUTOMATION_N8N_DISPATCH_MAX_ATTEMPTS=3

# OpenAI-compatible provider. Mock mode remains complete and deterministic.
# Leave the key blank here. Reuse the approved key only from ignored .env.local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# n8n self-hosted runtime
# -----------------------------------------------------------------------------
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
N8N_LOG_LEVEL=info
