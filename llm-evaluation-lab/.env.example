COMPOSE_PROJECT_NAME=evalforge
POSTGRES_DB=evalforge
POSTGRES_USER=evalforge
POSTGRES_PASSWORD=replace-for-any-shared-environment
POSTGRES_PORT=5435
BACKEND_PORT=8003
FRONTEND_PORT=3003
VITE_API_BASE_URL=/api/v1

EVALFORGE_ENVIRONMENT=development
EVALFORGE_DATABASE_URL=postgresql+psycopg://evalforge:replace-for-any-shared-environment@postgres:5432/evalforge
EVALFORGE_CORS_ORIGINS=["http://localhost:3003","http://localhost:5173"]
EVALFORGE_AUTO_SEED=true
EVALFORGE_DATASET_PATH=/app/data/datasets/evalforge_cases.jsonl
EVALFORGE_PROVIDER_MODE=mock
EVALFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
EVALFORGE_AIPRIMETECH_BASE_URL=https://aiprimetech.io/v1
EVALFORGE_REQUEST_TIMEOUT_SECONDS=30
EVALFORGE_RUNNER_CONCURRENCY=6
EVALFORGE_GIT_COMMIT=

# Provider credentials stay empty in tracked files. Existing ignored Nexora env
# files are loaded by Compose when present; local overrides can use .env.local.
OPENAI_API_KEY=
AIPRIMETECH_API_KEY=
