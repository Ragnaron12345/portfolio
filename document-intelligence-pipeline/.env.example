COMPOSE_PROJECT_NAME=docintel
POSTGRES_DB=docintel
POSTGRES_USER=docintel
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_PORT=5434
BACKEND_PORT=8002
FRONTEND_PORT=3001
VITE_API_BASE_URL=/api/v1

DOCINTEL_ENVIRONMENT=development
DOCINTEL_DATABASE_URL=sqlite:///./docintel.db
DOCINTEL_PROVIDER_MODE=mock
DOCINTEL_OPENAI_BASE_URL=https://api.openai.com/v1
DOCINTEL_OPENAI_MODEL=gpt-4.1-mini
DOCINTEL_PROVIDER_TIMEOUT_SECONDS=30
DOCINTEL_PROVIDER_MAX_RETRIES=1
DOCINTEL_MAX_UPLOAD_BYTES=10485760
DOCINTEL_MAX_PAGES=50
DOCINTEL_MAX_IMAGE_PIXELS=40000000
DOCINTEL_AUTO_ACCEPT_THRESHOLD=0.85
DOCINTEL_CORS_ORIGINS=["http://localhost:3001","http://localhost:5173"]
DOCINTEL_STORAGE_DIR=../data/uploads
DOCINTEL_GROUND_TRUTH_PATH=../data/ground_truth.json
DOCINTEL_SEED_DEMO=true

# Keep provider credentials only in ignored .env.local.
OPENAI_API_KEY=
